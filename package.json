{
  "name": "opencode-review-bridge",
  "version": "2.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "test": "node --test",
    "lint": "eslint .",
    "gate": "npm test && npm run lint && npm audit --audit-level=high",
    "bridge": "node ./bridge/bridge.mjs",
    "dev": "OPENCODE_CONFIG=./opencode.developer.json opencode serve --port 4096 --hostname 127.0.0.1",
    "review": "OPENCODE_CONFIG=./opencode.reviewer.json opencode serve --port 4097 --hostname 127.0.0.1",
    "dev:server": "OPENCODE_CONFIG=./opencode.developer.json opencode serve --port 4096 --hostname 127.0.0.1",
    "dev:tui": "set -a; . ./.env; set +a; OPENCODE_PASSWORD=$DEV_URL_PASSWORD opencode --server http://127.0.0.1:4096",
    "review:server": "OPENCODE_CONFIG=./opencode.reviewer.json opencode serve --port 4097 --hostname 127.0.0.1",
    "review:tui": "set -a; . ./.env; set +a; OPENCODE_PASSWORD=$REV_URL_PASSWORD opencode --server http://127.0.0.1:4097",
    "start:all": "concurrently -n bridge,dev,review -c green,blue,magenta \"npm run bridge\" \"npm run dev\" \"npm run review\"",
    "start:all:detached": "npm run bridge & npm run dev & npm run review",
    "attach:dev": "set -a; . ./.env; set +a; OPENCODE_PASSWORD=$DEV_URL_PASSWORD opencode --server http://127.0.0.1:4096",
    "attach:review": "set -a; . ./.env; set +a; OPENCODE_PASSWORD=$REV_URL_PASSWORD opencode --server http://127.0.0.1:4097"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opencode-ai/sdk": "latest",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
