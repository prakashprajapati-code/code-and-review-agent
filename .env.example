# Copy to .env (the preflight script does this automatically on first run):
#   cp .env.example .env   # preflight replaces the passwords with random ones
# opencode Basic-auth user is always "opencode". Passwords must match what
# the bridge reads from this same file.
USER_NAME=opencode
DEV_URL=http://127.0.0.1:4096
REV_URL=http://127.0.0.1:4097
# generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEV_URL_PASSWORD=change-me-developer
REV_URL_PASSWORD=change-me-reviewer
